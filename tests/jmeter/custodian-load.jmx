      <OpenModelThreadGroup guiclass="OpenModelThreadGroupGui" testclass="OpenModelThreadGroup" testname="Spike - sudden burst, then recovery (open model)">
        <stringProp name="TestPlan.comments">Profile "spike": does staging survive a sudden burst and recover afterwards? Open model: baseline -JspikeBaseRate journeys/s for -JspikeBase s, jump to -JspikePeakRate within -JspikeRise s, hold -JspikeHold s, drop back and watch -JspikeRecover s. Samples are tagged baseline / spike / recovery (column spikePhase).</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="OpenModelThreadGroupController"/>
        <stringProp name="OpenModelThreadGroup.schedule">${__P(spikeSchedule,rate(0/sec) random_arrivals(1 sec))}</stringProp>
        <stringProp name="OpenModelThreadGroup.random_seed">${__P(randomSeed,0)}</stringProp>
      </OpenModelThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Tag the spike phase (baseline / spike / recovery)">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="filename"/>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Tags every spike sample with its phase in the variable spikePhase: baseline, spike or recovery.
// With sample_variables=spikePhase (report.properties) JMeter writes it as an extra .jtl column, so the
// analysis can compare response times before, during and after the spike (did the system recover?).
// The clock starts when setUp finished (property loadStartMs), which is when the spike schedule starts.
long start = props.getProperty('loadStartMs', System.currentTimeMillis() as String) as long
def ends = props.getProperty('spikePhaseEnds', '60,94').split(',')*.toInteger()
long sec = (System.currentTimeMillis() - start).intdiv(1000)
vars.put('spikePhase', sec &lt; ends[0] ? 'baseline' : sec &lt; ends[1] ? 'spike' : 'recovery')</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Use a signed-in QA account">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="filename"/>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Runs before every sampler in this group, but only does work once per virtual user:
// it picks a token slot from setUp (round-robin on the thread number) and keeps it in this thread's vars.
if (vars.get('token') == null) {
    int count = props.getProperty('qaAccountCount', '0') as int
    if (count == 0) {
        log.error('No signed-in QA account (did setUp fail?)')
        return
    }
    int slot = (ctx.getThreadNum() % count) + 1
    vars.put('token', props.getProperty('qaToken_' + slot))
    vars.put('tenantId', props.getProperty('qaTenant_' + slot))
}</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization: workspace token">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${token}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think time 0.5-1.5 s">
          <stringProp name="ConstantTimer.delay">${__P(spikeThinkMin,500)}</stringProp>
          <stringProp name="RandomTimer.range">${__P(spikeThinkRand,1000)}</stringProp>
        </UniformRandomTimer>
        <hashTree/>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If setUp did not pass (guard refused, or no account signed in)">
          <stringProp name="IfController.condition">${__jexl3("${__P(stagingGuard,none)}" != "passed" || ${__P(qaAccountCount,0)} == 0)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Stop the whole test now (send nothing)">
            <intProp name="ActionProcessor.action">2</intProp>
            <intProp name="ActionProcessor.target">2</intProp>
            <stringProp name="ActionProcessor.duration">0</stringProp>
          </TestAction>
          <hashTree/>
        </hashTree>
        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Circuit breaker (stop when the error rate is too high)">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters">spike 50</stringProp>
          <stringProp name="filename"/>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Circuit breaker, shared by Stress and Spike. Parameters: &lt;prefix&gt; &lt;default max error %&gt;, e.g. "stress 20".
// Every &lt;prefix&gt;AbortWindow samples (default 100) it logs the error rate and active threads; if the window's
// error rate is above &lt;prefix&gt;AbortErrorPct, it stops the test immediately (Stop Now):
// a graceful stop does not end the Open Model arrival scheduler, so JMeter would never exit.
// Counters live in a property (shared by all threads) as an AtomicLongArray [samples, errors] for thread safety.
import java.util.concurrent.atomic.AtomicLongArray
import org.apache.jmeter.threads.JMeterContextService
String prefix = args[0]
int window = props.getProperty(prefix + 'AbortWindow', '100') as int
double maxErrPct = props.getProperty(prefix + 'AbortErrorPct', args[1]) as double
def c = props.computeIfAbsent(prefix + 'Breaker', { k -&gt; new AtomicLongArray(2) })
long n = c.incrementAndGet(0)
long errors = sampleResult.isSuccessful() ? c.get(1) : c.incrementAndGet(1)
if (n == window) {
    c.set(0, 0); c.set(1, 0)
    double pct = 100.0 * errors / n
    int active = JMeterContextService.getNumberOfThreads()
    String phase = vars.get('spikePhase') ? ' [' + vars.get('spikePhase') + ']' : ''
    log.info(String.format('%s window%s: %d samples, %.1f%% errors, %d active threads', prefix, phase, n, pct, active))
    if (pct &gt; maxErrPct) {
        log.error(String.format('Circuit breaker OPEN (%s): %.1f%% errors &gt; %.1f%% with %d active threads - stopping the test', prefix, pct, maxErrPct, active))
        props.put(prefix + 'BreakerTripped', String.format('%.1f%% errors at %d active threads', pct, active))
        ctx.getEngine().stopTest(true)
    }
}</stringProp>
        </JSR223Listener>
