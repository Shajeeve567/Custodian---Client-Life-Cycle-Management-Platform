      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Smoke - every key endpoint (few users)">
        <stringProp name="TestPlan.comments">Profile &quot;smoke&quot;: does the script and the deployment work at all? 1 user x 3 loops by default (-JsmokeUsers, -JsmokeLoops). Thread count is 0 (group skipped) for any other profile.</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(smokeLoops,3)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__jexl3(&quot;${__P(profile,smoke)}&quot; == &quot;smoke&quot; ? ${__P(smokeUsers,1)} : 0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(smokeRampUp,1)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Use a signed-in QA account">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Runs before every sampler in this group, but only does work once per virtual user:
// it picks a token slot from setUp (round-robin on the thread number) and keeps it in this thread&apos;s vars.
if (vars.get(&apos;token&apos;) == null) {
    int count = props.getProperty(&apos;qaAccountCount&apos;, &apos;0&apos;) as int
    if (count == 0) {
        log.error(&apos;No signed-in QA account (did setUp fail?)&apos;)
        return
    }
    int slot = (ctx.getThreadNum() % count) + 1
    vars.put(&apos;token&apos;, props.getProperty(&apos;qaToken_&apos; + slot))
    vars.put(&apos;tenantId&apos;, props.getProperty(&apos;qaTenant_&apos; + slot))
}</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization: workspace token">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${token}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think time (thinkMin + 0..thinkRand ms)">
