      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Load - expected concurrency (weighted staff journey)">
        <stringProp name="TestPlan.comments">Profile "load": can staging meet its targets at the expected number of concurrent staff? Closed model: loadUsers virtual users (default 20) start over loadRampUp s (60), then hold for loadHold s (180). Duration = ramp-up + hold. Each iteration is one staff journey; Throughput Controllers set the mix.</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__jexl3("${__P(profile,smoke)}" == "load" ? ${__P(loadUsers,20)} : 0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(loadRampUp,60)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__jexl3(${__P(loadRampUp,60)} + ${__P(loadHold,180)})}</stringProp>
        <stringProp name="ThreadGroup.delay"/>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
