        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Once per test"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Guard: refuse non-staging targets">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"/>
            <stringProp name="filename"/>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Safety guard. Load tests may only hit Custodian STAGING, or a loopback server (local stack / mock).
// It runs before any HTTP request; a failure stops the test (setUp: "Stop Test Now" on error).
def names = ['identityUrl', 'workflowUrl', 'documentsUrl', 'auditUrl']
def urls = names.collect { props.getProperty(it, '') }
def staging = /^https:\/\/staging-[a-z]+-service-[a-z0-9]+\.centralindia-01\.azurewebsites\.net$/
def loopback = /^http:\/\/(localhost|127\.0\.0\.1):\d+$/
boolean allowed = urls.every { it ==~ staging } || urls.every { it ==~ loopback }

props.put('qaAccountCount', '0')   // reset the token slots (properties outlive a run in GUI mode)
// Every HTTP request in the plan is behind a check of this property, so the plan fails closed:
// if the guard refuses, or never runs (e.g. missing accounts.csv), nothing is sent.
props.put('stagingGuard', allowed ? 'passed' : 'refused')
SampleResult.setResponseData([names, urls].transpose().collect { it.join('=') }.join('\n'), 'UTF-8')
if (allowed) {
    SampleResult.setResponseCodeOK()
    SampleResult.setResponseMessage('All targets are staging (or loopback)')
} else {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('GUARD')
    SampleResult.setResponseMessage('Refused: every URL must be a Custodian staging host (or all loopback)')
    log.error('Staging guard refused the targets: ' + urls)
}</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="setUp: build the open-model schedules">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"/>
            <stringProp name="filename"/>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Builds the Open Model Thread Group schedule from simple properties, so a run is tuned with -J flags
// instead of hand-writing the schedule language. Stress = a staircase of arrival rates (journeys per second):
//   -JstressLevels=1,2,4,6,8   -JstressStep=60 (s held at each level)   -JstressRamp=10 (s to climb to it)
// gives: rate(0/sec) random_arrivals(10 sec) rate(1/sec) random_arrivals(60 sec) rate(1/sec) random_arrivals(10 sec) rate(2/sec) ...
// Spike = steady baseline, a sudden jump, then back to baseline to watch recovery:
//   -JspikeBaseRate=1 -JspikePeakRate=8 (journeys/s)  -JspikeBase=60 -JspikeRise=2 -JspikeHold=30 -JspikeRecover=60 (s)
// A profile that is not selected gets a schedule with rate 0, so its thread group starts no threads.
def staircase = { String levelsProp, String levelsDefault, String holdProp, String rampProp -&gt;
    def levels = props.getProperty(levelsProp, levelsDefault).split(',')*.trim()*.toBigDecimal()
    int hold = props.getProperty(holdProp, '60') as int
    int ramp = props.getProperty(rampProp, '10') as int
    def parts = ['rate(0/sec)']
    levels.each { l -&gt; parts &lt;&lt; "random_arrivals(${ramp} sec)" &lt;&lt; "rate(${l}/sec)" &lt;&lt; "random_arrivals(${hold} sec)" &lt;&lt; "rate(${l}/sec)" }
    parts.join(' ')
}
def off = 'rate(0/sec) random_arrivals(1 sec)'
def profile = props.getProperty('profile', 'smoke')
def stress = profile == 'stress' ? staircase('stressLevels', '1,2,4,6,8', 'stressStep', 'stressRamp') : off
props.put('stressSchedule', stress)

def p = { String name, String dflt -&gt; props.getProperty(name, dflt) }
def base = p('spikeBase', '60') as int, rise = p('spikeRise', '2') as int
def hold = p('spikeHold', '30') as int, recover = p('spikeRecover', '60') as int
def b = p('spikeBaseRate', '1'), peak = p('spikePeakRate', '8')
def spike = profile != 'spike' ? off : [
    "rate(${b}/sec) random_arrivals(${base} sec)",                       // baseline
    "rate(${b}/sec) random_arrivals(${rise} sec) rate(${peak}/sec)",     // sudden jump
    "random_arrivals(${hold} sec) rate(${peak}/sec)",                    // hold the peak
    "random_arrivals(${rise} sec) rate(${b}/sec)",                       // drop back
    "random_arrivals(${recover} sec) rate(${b}/sec)"].join(' ')          // recovery
props.put('spikeSchedule', spike)
// Phase boundaries in seconds from the first spike arrival: [0, base) baseline, [base, base+2*rise+hold) spike, then recovery
props.put('spikePhaseEnds', "${base},${base + 2 * rise + hold}" as String)

['stressBreaker', 'spikeBreaker', 'loadStartMs'].each { props.remove(it) }   // leftovers from a previous run (GUI mode)
SampleResult.setResponseData("stressSchedule=${stress}\nspikeSchedule=${spike}", 'UTF-8')
log.info('Stress schedule: ' + stress)
log.info('Spike schedule: ' + spike)</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
