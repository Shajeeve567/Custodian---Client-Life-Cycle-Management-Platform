<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Custodian load &amp; performance (staging)">
      <stringProp name="TestPlan.comments">SE3112 load &amp; performance tests for the Custodian microservices (Identity, Workflow, Documents, Audit) on STAGING only.
Run headless: jmeter -n -t custodian-load.jmx -q staging.properties -Jprofile=smoke -l results/smoke.jtl -e -o reports/smoke
Profiles (-Jprofile=): smoke, load, stress, spike.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="IDENTITY_URL" elementType="Argument">
            <stringProp name="Argument.name">IDENTITY_URL</stringProp>
            <stringProp name="Argument.value">${__P(identityUrl)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="WORKFLOW_URL" elementType="Argument">
            <stringProp name="Argument.name">WORKFLOW_URL</stringProp>
            <stringProp name="Argument.value">${__P(workflowUrl)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DOCUMENTS_URL" elementType="Argument">
            <stringProp name="Argument.name">DOCUMENTS_URL</stringProp>
            <stringProp name="Argument.value">${__P(documentsUrl)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUDIT_URL" elementType="Argument">
            <stringProp name="Argument.name">AUDIT_URL</stringProp>
            <stringProp name="Argument.value">${__P(auditUrl)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DATA_DIR" elementType="Argument">
            <stringProp name="Argument.name">DATA_DIR</stringProp>
            <stringProp name="Argument.value">${__P(dataDir,data)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
