            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Share the workspace token with all thread groups">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"/>
              <stringProp name="filename"/>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Variables (vars) belong to one thread and die with it; the setUp thread ends before the load starts.
// Properties (props) are global to the JMeter process, so the token is copied into slot qaToken_N.
def token = vars.get('workspaceToken')
if (!prev.isSuccessful() || token == null || token == 'NOT_FOUND') {
    return   // the assertions above already failed this sample, which stops the test
}
int n = (props.getProperty('qaAccountCount', '0') as int) + 1
props.put('qaToken_' + n, token)
props.put('qaTenant_' + n, vars.get('tenantId'))
props.put('qaAccountCount', n as String)
// The last account signed in = the end of setUp = the moment JMeter starts every other thread group.
// The spike phase clock counts from here (the schedule starts now, not at the first random arrival).
props.put('loadStartMs', System.currentTimeMillis() as String)
log.info('Signed in QA account ' + n + ' (tenant ' + vars.get('tenantId') + ')')</stringProp>
            </JSR223PostProcessor>
