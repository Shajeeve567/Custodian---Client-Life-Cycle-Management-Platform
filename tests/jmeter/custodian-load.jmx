      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Use a signed-in QA account">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="filename"/>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Runs before every sampler in this group, but only does work once per virtual user:
// it picks a token slot from setUp (round-robin on the thread number) and keeps it in this thread's vars.
if (vars.get('token') == null) {
    int count = props.getProperty('qaAccountCount', '0') as int
    if (count == 0) {
        log.error('No signed-in QA account (did setUp fail?)')
        return
    }
    int slot = (ctx.getThreadNum() % count) + 1
    vars.put('token', props.getProperty('qaToken_' + slot))
    vars.put('tenantId', props.getProperty('qaTenant_' + slot))
}</stringProp>
        </JSR223PreProcessor>
