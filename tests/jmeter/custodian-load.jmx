            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Share the workspace token with all thread groups">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Variables (vars) belong to one thread and die with it; the setUp thread ends before the load starts.
// Properties (props) are global to the JMeter process, so the token is copied into slot qaToken_N.
def token = vars.get(&apos;workspaceToken&apos;)
if (!prev.isSuccessful() || token == null || token == &apos;NOT_FOUND&apos;) {
    return   // the assertions above already failed this sample, which stops the test
}
int n = (props.getProperty(&apos;qaAccountCount&apos;, &apos;0&apos;) as int) + 1
props.put(&apos;qaToken_&apos; + n, token)
props.put(&apos;qaTenant_&apos; + n, vars.get(&apos;tenantId&apos;))
props.put(&apos;qaAccountCount&apos;, n as String)
log.info(&apos;Signed in QA account &apos; + n + &apos; (tenant &apos; + vars.get(&apos;tenantId&apos;) + &apos;)&apos;)</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        </hashTree>
