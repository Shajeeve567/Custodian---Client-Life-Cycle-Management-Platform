        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="QA accounts (data/accounts.csv, git-ignored)">
          <stringProp name="filename">${DATA_DIR}/accounts.csv</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames"></stringProp>
          <boolProp name="ignoreFirstLine">false</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Once per test"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Guard: refuse non-staging targets">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Safety guard. Load tests may only hit Custodian STAGING, or a loopback server (local stack / mock).
// It runs before any HTTP request; a failure stops the test (setUp: &quot;Stop Test Now&quot; on error).
def names = [&apos;identityUrl&apos;, &apos;workflowUrl&apos;, &apos;documentsUrl&apos;, &apos;auditUrl&apos;]
def urls = names.collect { props.getProperty(it, &apos;&apos;) }
def staging = /^https:\/\/staging-[a-z]+-service-[a-z0-9]+\.centralindia-01\.azurewebsites\.net$/
def loopback = /^http:\/\/(localhost|127\.0\.0\.1):\d+$/
boolean allowed = urls.every { it ==~ staging } || urls.every { it ==~ loopback }

props.put(&apos;qaAccountCount&apos;, &apos;0&apos;)   // reset the token slots (properties outlive a run in GUI mode)
// Every HTTP request in the plan is behind a check of this property, so the plan fails closed:
// if the guard refuses, or never runs (e.g. missing accounts.csv), nothing is sent.
props.put(&apos;stagingGuard&apos;, allowed ? &apos;passed&apos; : &apos;refused&apos;)
SampleResult.setResponseData([names, urls].transpose().collect { it.join(&apos;=&apos;) }.join(&apos;\n&apos;), &apos;UTF-8&apos;)
if (allowed) {
    SampleResult.setResponseCodeOK()
    SampleResult.setResponseMessage(&apos;All targets are staging (or loopback)&apos;)
} else {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;GUARD&apos;)
    SampleResult.setResponseMessage(&apos;Refused: every URL must be a Custodian staging host (or all loopback)&apos;)
    log.error(&apos;Staging guard refused the targets: &apos; + urls)
}</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Only if the staging guard passed">
          <stringProp name="IfController.condition">${__jexl3(&quot;${__P(stagingGuard,none)}&quot; == &quot;passed&quot;)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setUp: POST /api/Auth/login">
