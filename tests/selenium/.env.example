# ==============================================================================
# Custodian E2E Testing Environment Configuration Template
# Copy this file to '.env.e2e.local' in 'tests/selenium/' for local test execution.
# DO NOT commit real passwords, secrets, or sensitive tokens to Git.
# ==============================================================================

# Target Web Application Base URL (Local or Staging QA)
E2E_BASE_URL=http://localhost:3000
E2E_TENANT_NAME="SE3112 E2E Testing Agency"

# Baseline Role Credentials (Provisioned in QA Identity Service)
E2E_OWNER_EMAIL=owner.qa@example.com
E2E_OWNER_PASSWORD=<your_qa_owner_password>
E2E_STAFF_EMAIL=staff.qa@example.com
E2E_STAFF_PASSWORD=<your_qa_staff_password>
E2E_CLIENT_EMAIL=client.qa@example.com
E2E_CLIENT_PASSWORD=<your_qa_client_password>

# Dedicated Stage 2 Fixture Client (Used for APPR01, DOC01, DOC02)
E2E_STAGE2_CLIENT_EMAIL=stage2.client.qa@example.com
E2E_STAGE2_CLIENT_PASSWORD=<your_qa_stage2_client_password>

# Optional: Microservice Backend Direct API Endpoints (Defaults to localhost ports)
E2E_IDENTITY_URL=http://localhost:5281
E2E_WORKFLOW_URL=http://localhost:5225
E2E_DOCUMENTS_URL=http://localhost:5171
E2E_AUDIT_URL=http://localhost:5051

# Execution Pacing & Demo Mode Options
SELENIUM_HEADLESS=false
SELENIUM_DEMO_MODE=true
SELENIUM_DEMO_DELAY_MS=800
