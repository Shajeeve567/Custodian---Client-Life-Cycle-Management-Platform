{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=workflow_db;User=root;Password=password;",
    "AzureMySqlConnection": "YOUR_SECRET_STRING"
  },
  "Services": {
    "AuditUrl": "https://staging-audit-service-e3hhf9hwgjf9h2dg.centralindia-01.azurewebsites.net",
    "DocumentsUrl": "https://staging-document-service-gch7d3duetb8ceby.centralindia-01.azurewebsites.net"
  },
  "Jwt": {
    "SigningKey": "custodian_super_secret_development_signing_key_at_least_64_bytes_long_1234567890",
    "Issuer": "custodian-identity",
    "Audience": "custodian-services",
    "ExpiryMinutes": 60
  },
  "Audit": {
    "Transport": "Kafka"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "custodian.events",
    "ClientId": "workflow-service",
    "ConsumerEnabled": true,
    "GroupId": "custodian-workflow"
  },
  "Sla": {
    "DefaultOverdueHours": 72,
    "StageOverdueHours": {
      "1": 48,
      "2": 72,
      "3": 96,
      "4": 120,
      "5": 138
    },
    "Urgency": {
      "GatingWeight": 2.0,
      "DefaultWeight": 1.0
    }
  }
}
