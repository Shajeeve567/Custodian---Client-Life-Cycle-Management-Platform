{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=audit_db;User=root;Password=password;",
    "AzureMySqlConnection": "YOUR_SECRET_STRING"
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "GroupId": "custodian-audit",
    "Topic": "custodian.events",
    "AutoOffsetReset": "Earliest"
  }
}