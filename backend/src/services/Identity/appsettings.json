{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AzureMySqlConnection": "YOUR_SECRET_STRING" 
  },
  "Jwt": {
    "Key": "",
    "Issuer": "custodian-identity",
    "Audience": "custodian-services",
    "ExpiryMinutes": "60"
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "onboarding@resend.dev",
    "ApiUrl": "https://api.resend.com"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "GroupId": "custodian-identity-notifications-group",
    "Topic": "custodian.events",
    "AutoOffsetReset": "Earliest"
  }
}
