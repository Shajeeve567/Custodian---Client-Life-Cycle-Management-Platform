# Identity Service
IDENTITY_DB_CONNECTION=Server=custodian-mysql.mysql.database.azure.com;Port=3306;Database=identity_db;User=cstteam04y3sem2;Password=FILL_IN_HERE;SslMode=Required;

# Local MySQL container (docker-compose only)
DB_ROOT_PASSWORD=FILL_IN_HERE

# JWT Configuration. Must be a real random secret (e.g. `openssl rand -base64 64`), identical for
# all four services. Services refuse to start with this placeholder, and outside Development they
# also refuse the development key committed in appsettings.json.
JWT_KEY=FILL_IN_HERE_minimum_64_chars
JWT_ISSUER=custodian-identity
JWT_AUDIENCE=custodian-services
JWT_EXPIRY_MINUTES=60

# Workflow Service
WORKFLOW_DB_CONNECTION=Server=custodian-mysql.mysql.database.azure.com;Port=3306;Database=workflow_db;User=cstteam04y3sem2;Password=FILL_IN_HERE;SslMode=Required;

# Document Service
DOCUMENT_DB_CONNECTION=Server=custodian-mysql.mysql.database.azure.com;Port=3306;Database=document_db;User=cstteam04y3sem2;Password=FILL_IN_HERE;SslMode=Required;

# Audit Service
AUDIT_DB_CONNECTION=Server=custodian-mysql.mysql.database.azure.com;Port=3306;Database=audit_db;User=cstteam04y3sem2;Password=FILL_IN_HERE;SslMode=Required;

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=FILL_IN_HERE

# Azure Blob Storage (Document Service)
AZURE_BLOB_CONNECTION_STRING=FILL_IN_HERE
AZURE_BLOB_CONTAINER_NAME=custodian-documents

# QA Test Account Credentials
QA_AUTH_EMAIL=your_actual_qa_user@example.com
QA_AUTH_PASSWORD=your_actual_qa_password

# Kafka / Azure Event Hubs
Audit__Transport=Kafka
Kafka__Enabled=true
Kafka__BootstrapServers=custodian-events.servicebus.windows.net:9093
Kafka__Topic=custodian.events
Kafka__GroupId=custodian-audit
Kafka__SecurityProtocol=SaslSsl
Kafka__SaslMechanism=Plain
Kafka__SaslUsername=$ConnectionString
Kafka__SaslPassword=

# Service-to-service key for HTTP audit ingestion (POST /api/audit-events). Generate a long random
# value per environment (e.g. `openssl rand -hex 32`, at least 32 characters); the same value goes to
# audit, workflow and documents. Left as this placeholder, audit HTTP ingestion stays disabled.
AUDIT_INGESTION_KEY=<generate-a-random-secret>
